# Cisdem-style keyword blocking. The Cerberus browser extension cancels any
# page/search whose URL contains one of these (case-insensitive substring, so
# "manga" blocks both manga searches and manga-domains). Add terms via:
#   cerberus keyword add <term>
# Warning: terms are matched as substrings — short/generic words (sex, xxx)
# will also block unrelated URLs that happen to contain them.
SEARCH_BLOCK_KEYWORDS=(
  "manga"
  "manhwa"
  "manhua"
  "hentai"
  "porn"
  "sex"
  "xxx"
  "18+"
  "toomics"
)
