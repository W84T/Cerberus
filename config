CUSTOM_BLOCK_FILE="/opt/cerberus/custom-block.txt"
GIT_REPO_URL="https://github.com/W84T/Cerberus.git"

# SQLite database for blocking
DB_PATH="/opt/cerberus/cerberus.db"
RESOLVER_PORT=5353

# Enabled optional categories (edit to disable)
ENABLED_OPTIONALS=(
  "facebook"
  "twitter"
  "youtube"
  "tiktok"
  "redirect"
  "tracking"
)

# Domains always allowed (exact match + all subdomains), even if present in blocklists
ALWAYS_ALLOW=(
  "whatsapp.com"
  "whatsapp.net"
  "whatsapp.org"
  "wa.me"
)

# Penalty (anti-abuse): when a blocked domain is requested, kill all internet
# on this machine for PENALTY_MINUTES minutes (restarted on each new hit).
# PENALTY_SECONDS overrides the duration precisely if set. Minimum enforced is
# 5 minutes via the CLI; this can only change duration, never disable.
PENALTY_MINUTES=5
PENALTY_SIGNAL_FILE="/var/lib/cerberus/penalty_signal"
PENALTY_STATE_FILE="/var/lib/cerberus/penalty_state"

